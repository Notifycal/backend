// This config is purely for type checking
// Bundling is done with esbuild
{
  "compilerOptions": {
    "module": "Preserve",   // This is for dev experience, in reality esbuild uses CommonJS
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "strict": true,
    "preserveConstEnums": true,
    "noEmit": true,
    "baseUrl": "src",
    "typeRoots": ["node_modules/@types"],
    "paths": {
      "@powertools": ["common/powertools"],
      "@clients/*": ["clients/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
