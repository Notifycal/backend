{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "strict": true,
    "preserveConstEnums": true,
    "noEmit": true,
    "baseUrl": ".",
    "typeRoots": ["node_modules/@types"],
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
