{
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "target": "ES2020",
    "strict": true,
    "preserveConstEnums": true,
    "noEmit": true,
    "baseUrl": "src",
    "typeRoots": ["node_modules/@types"],
    "paths": {
      "@powertools": ["common/powertools"],
      "@clients/*": ["clients/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
