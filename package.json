  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && NODE_ENV=production node esbuild.js",
    "dev-build": "rm -rf dist && node esbuild.js",
    "dev": "nodemon --ext ts,js,yaml,yml --watch src/** --watch openapi/** --exec 'npm run dev-build && node --env-file=src/resources/config/.env.dev express-local/index.js'",
    "package": "bin/package.sh",
    "lint": "eslint -c ./eslint.config.js",
    "lint:fix": "$npm_execpath run lint -- --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "$npm_execpath run prettier -- --write",
    "types": "tsc",
    "test": "jest"
  },
  "author": "",
  "license": "ISC",
