{
  "name": "backend",
  "version": "0.14.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bin/build.sh",
    "dev-build": "$npm_execpath run clean && node esbuild.js",
    "dev": "pm2 start --no-daemon ecosystem.dev.config.cjs",
    "package": "bin/package.sh",
    "lint": "spectral lint tf/openapi/spec.yaml && eslint -c ./eslint.config.js",
    "lint:fix": "$npm_execpath run lint -- --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "$npm_execpath run prettier -- --write",
    "check": "$npm_execpath run types && $npm_execpath run lint && $npm_execpath run prettier && $npm_execpath run test && echo 'Everything ready to go upstream' || echo 'CAUTION: Have another look'",
    "types": "tsc",
    "test": "vitest --watch=false",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-lambda-powertools/batch": "^2.13.1",
    "@aws-lambda-powertools/logger": "^2.12.0",
    "@aws-lambda-powertools/metrics": "^2.12.0",
    "@aws-lambda-powertools/parser": "^2.12.0",
    "@aws-lambda-powertools/tracer": "^2.12.0",
    "@aws-sdk/client-dynamodb": "^3.741.0",
    "@aws-sdk/client-sns": "^3.741.0",
    "@aws-sdk/client-sqs": "^3.741.0",
    "@aws-sdk/lib-dynamodb": "^3.741.0",
    "@middy/core": "^6.0.0",
    "@middy/http-cors": "^6.0.0",
    "@notifycal/shared": "^1.3.0",
    "env-var": "^7.5.0",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "ts-pattern": "^5.6.2",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.723.0",
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.18.0",
    "@stoplight/spectral-cli": "^6.14.2",
    "@types/aws-lambda": "^8.10.147",
    "@types/http-errors": "^2.0.4",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.6",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^3.0.2",
    "@vitest/eslint-plugin": "^1.1.25",
    "@vitest/ui": "^3.0.2",
    "body-parser": "^1.20.3",
    "connect-timeout": "^1.9.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "express": "^4.21.2",
    "glob": "^11.0.1",
    "globals": "^15.14.0",
    "pm2": "^5.4.3",
    "prettier": "^3.4.2",
    "spectral-aws-apigateway-ruleset": "^2.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.2"
  }
}
