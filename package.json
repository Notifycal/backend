    "@aws-lambda-powertools/tracer": "^2.11.0",
    "@aws-sdk/client-dynamodb": "^3.705.0",
    "@aws-sdk/client-sqs": "^3.699.0",
    "@aws-sdk/lib-dynamodb": "^3.705.0",
    "@middy/core": "^4.7.0",
    "@middy/http-error-handler": "^6.0.0",
    "env-var": "^7.5.0",
    "google-auth-library": "^9.15.0",
