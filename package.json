    "@typescript-eslint/parser": "^8.18.0",
    "body-parser": "^1.20.2",
    "dotenv": "^16.4.7",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.5.0",
