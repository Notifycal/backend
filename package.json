    "build": "rm -rf dist && NODE_ENV=production node esbuild.js",
    "dev-build": "rm -rf dist && node esbuild.js",
    "dev": "nodemon --ext ts,js,yaml,yml --watch src/** --watch openapi/** --exec 'npm run dev-build && node express-local/index.js'",
